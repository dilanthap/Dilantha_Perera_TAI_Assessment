# Copy this file to .env and fill in your key:
#   cp .env.example .env
#
# .env is gitignored — never commit a real key.

ANTHROPIC_API_KEY=your_key_here

# Optional: only needed for the policy library (/library) — embeddings for
# chunk retrieval. The rest of the app (upload -> quiz -> results) does not
# use this. Get a free-tier key at https://dashboard.voyageai.com
VOYAGE_API_KEY=your_voyage_key_here

# Optional: run the whole app with bundled sample data instead of live API calls.
# No key and no network required. Useful for trying the UI, or for demoing.
# Covers both the quiz loop and the policy library.
#   DEMO_MODE=1
